NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — só no servidor
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# user_id (uuid) dos donos, separados por vírgula, com acesso a /admin
ADMIN_IDS=

# Origem pública do app (usada no link mágico do OTP e no Atalho do iOS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
